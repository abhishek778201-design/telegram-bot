# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=quizplatform

# Bot Configuration
BOT_TOKEN_EXTRACT=your_extractor_bot_token
BOT_TOKEN_CREATOR=your_creator_bot_token
BOT_TOKEN_RUNNER=your_runner_bot_token
ADMIN_USERS=123456,789012

# Payment Configuration (Razorpay)
RAZORPAY_KEY_ID=rzp_your_key_id
RAZORPAY_KEY_SECRET=rzp_your_secret

# API Keys
OPENAI_API_KEY=your_openai_key
AI_MODEL=gpt-4

# WebApp Configuration
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8000

# Security
HMAC_SECRET=your_hmac_secret
SESSION_SECRET=your_session_secret

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600

# Monitoring
TELEGRAM_API_TIMEOUT=30
MAX_INLINE_QUERY_RESULTS=50